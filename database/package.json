{
  "name": "@portal.formulalsu.org/database",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=\"drizzle\" bun build src/drizzle.config.ts src/models/*.ts --outdir=drizzle --target bun --minify --minify-syntax --minify-whitespace --minify-identifiers",
    "db:generate": "NODE_ENV=\"drizzle\" bunx --bun drizzle-kit generate --config drizzle/src/drizzle.config.js",
    "db:push": "NODE_ENV=\"drizzle\" bunx --bun drizzle-kit push --config drizzle/src/drizzle.config.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10"
  }
}
