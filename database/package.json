{
  "name": "@portal.formulalsu.org/database",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/drizzle.config.ts src/models/*.ts --outdir=drizzle --entry-naming='[name].[ext]' --target bun --minify",
    "db:check": "bunx --bun drizzle-kit check",
    "db:generate": "bunx --bun drizzle-kit generate --config drizzle/drizzle.config.js",
    "db:push": "bunx --bun drizzle-kit push --config drizzle/drizzle.config.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^1.0.0-rc.4-5d5b77c"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^1.0.0-rc.4-ca0f029"
  }
}
